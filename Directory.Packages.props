<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<!-- Referenced by every project. Computes Version, AssemblyVersion, and FileVersion; see Directory.Build.props. -->
		<GlobalPackageReference Include="Sagara.Build.Versioning" Version="1.0.0" />
		<PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
		<PackageVersion Include="Spectre.Console" Version="0.57.2" />
		<PackageVersion Include="System.CommandLine" Version="2.0.13" />
		<PackageVersion Include="TextCopy" Version="6.2.1" />
	</ItemGroup>
	<ItemGroup Label="Tests">
		<PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
	</ItemGroup>
</Project>